# Настройки сервера. Скопировать в .env рядом с docker-compose.prod.yml
# и заполнить своими значениями; .env в репозиторий не попадает.

DB_USER=ibcon
DB_PASSWORD=
DB_NAME=ibcon_budget

# Не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Часы жизни токена входа
JWT_EXPIRY_HOURS=60

# Домены, которым разрешены запросы из браузера, через запятую.
# Пусто — только свой адрес; так и нужно, когда фронтенд и API на одном хосте.
ALLOWED_ORIGINS=

# Если у сервера нет прямого выхода в интернет — адрес прокси.
# Влияет только на сбор объявлений в оценке рыночной аренды.
HTTPS_PROXY=
HTTP_PROXY=
